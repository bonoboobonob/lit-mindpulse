{
  "appId": "com.mindpulse.memoryapp",
  "appName": "LibrisMind",
  "webDir": "dist",
  "backgroundColor": "#F7F4EE",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#F7F4EE",
    "allowMixedContent": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#F7F4EE",
      "androidSplashResourceName": "splash",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  }
}
